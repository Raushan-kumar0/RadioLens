# Copy this file to .env and fill in real values. Never commit the real .env file.

# Flask session secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Set to 1 to enable Flask debug mode locally, 0 (or unset) in production
FLASK_DEBUG=0

# Google API key for the Gemini chatbot (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# Gmail address + App Password used to send the PDF report to patients
# (App Password, NOT your normal Gmail password: https://support.google.com/accounts/answer/185833)
MRIG_SENDER_EMAIL=your-sender@gmail.com
MRIG_SENDER_APP_PASSWORD=your-16-char-app-password
